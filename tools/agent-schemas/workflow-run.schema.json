{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel-ui.local/schemas/workflow-run.json",
  "title": "Pixel UI agent workflow-run artifact",
  "type": "object",
  "additionalProperties": true,
  "required": ["runId", "workflowType", "status", "gates", "agents", "blockers"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "workflowType": { "type": "string", "enum": ["PAGE", "LIBRARY"] },
    "status": {
      "type": "string",
      "enum": ["in_progress", "awaiting_human_qa", "blocked", "complete", "failed"]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "G0_docsPass",
        "G1_compositionApproved",
        "G2_implementation",
        "G4_quality",
        "G5_review",
        "G7_humanQa"
      ],
      "properties": {
        "G0_docsPass": { "$ref": "#/$defs/gate" },
        "G1_compositionApproved": { "$ref": "#/$defs/gate" },
        "G2_implementation": { "$ref": "#/$defs/gate" },
        "G3_a11yTheme": { "$ref": "#/$defs/gate" },
        "G4_quality": { "$ref": "#/$defs/gate" },
        "G5_review": { "$ref": "#/$defs/gate" },
        "G6_contractSync": { "$ref": "#/$defs/gate" },
        "G7_humanQa": { "$ref": "#/$defs/gate" }
      }
    },
    "agents": { "type": "object" },
    "blockers": { "type": "array" },
    "outputs": { "type": "object" }
  },
  "$defs": {
    "gate": { "type": "string", "enum": ["pending", "pass", "fail", "n/a"] }
  }
}
